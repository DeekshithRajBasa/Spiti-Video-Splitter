{
  "name": "spiti-video-splitter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "desktop:dev": "node electron/dev.cjs",
    "dist:win": "vite build && electron-builder --win --publish never",
    "dist:mac": "vite build && electron-builder --mac --publish never",
    "dist:linux": "vite build && electron-builder --linux --publish never",
    "build:cloudflare": "tsc -b && VITE_ORT_CDN=1 vite build && node scripts/check-file-sizes.mjs dist 25"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.81.0",
    "mp4-muxer": "^5.2.2",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "zod": "^4.6.7"
  },
  "description": "Turn widescreen podcasts, streams and gameplay into vertical clips.",
  "author": "Spiti",
  "main": "electron/main.cjs"
}
